PORT=5000
DATABASE_URL=postgresql://hhotel:hhotel@localhost:5432/hhotel
JWT_SECRET=hhotel-dev-secret-change-in-production
# Comma-separated frontend origins (Vercel URL in production).
CLIENT_URL=http://localhost:5173
# Public backend origin (Render URL in production). Used for Google OAuth redirect URI.
API_URL=http://localhost:5000

# Google OAuth 2.0 (optional — create credentials at https://console.cloud.google.com/)
# Authorized redirect URI must match API_URL + /api/auth/google/callback
# e.g. https://hotel-application-backend-yd7r.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Optional: stripe listen --forward-to localhost:5000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
